# SMTP настройки для отправки заявок на почту
# Скопируйте этот файл в .env.local и заполните данные

# Email для отправки писем
SMTP_USER=reception@laboratoriolampone.com.ru

# Пароль от почтового ящика (НЕ от аккаунта, а именно от почты)
SMTP_PASS=ВСТАВЬТЕ_ПАРОЛЬ_ОТ_ПОЧТЫ

# URL сайта (для CORS)
SITE_URL=https://laboratoriolampone.com.ru
